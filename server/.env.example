PORT=5000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/climat_center

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# CORS (production): comma-separated origins for the public site and admin
# CORS_ORIGINS=https://your-client.vercel.app,https://your-admin.vercel.app

# Next.js ISR revalidation (optional)
# PUBLIC_SITE_URL=https://your-client.vercel.app
# REVALIDATE_SECRET=change_me

# Uploads (local disk). On Vercel, set BLOB_READ_WRITE_TOKEN (Vercel Blob) instead.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# BLOB_READ_WRITE_TOKEN=

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(npm run reset:content *)",
      "Bash(*neon.tech*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(.envrc)",
      "Read(package-lock.json)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/coverage/**)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)"
    ]
  }
}
